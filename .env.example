# Ethereum Mainnet JSON-RPC endpoint (e.g., Alchemy or Infura)
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional shared token for external engine -> /api/update/ webhook authentication
CHRONOS_API_TOKEN=

# Optional standalone engine target URL
CHRONOS_SERVER_URL=http://127.0.0.1:8000/api/update/
